{
  "name": "citebot-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Narrow eval suite for CiteBot — grounded versus hallucinated handbook questions",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx src/cli.ts",
    "eval:live": "tsx src/cli.ts --provider citebot",
    "eval:fixture": "tsx src/cli.ts --provider fixture",
    "report": "tsx src/cli.ts --provider fixture --write-report"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
